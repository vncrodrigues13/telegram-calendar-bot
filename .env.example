# Copy to .env and fill in. See README.md for where each value comes from.

# --- Telegram (required) ---
# @BotFather -> /newbot -> copy the token
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Message @userinfobot to get your numeric ID. This locks the bot to you alone.
OWNER_TELEGRAM_ID=123456789

# --- LLM provider ---
# gemini | claude | openai. Only the selected provider's SDK and key are touched.
LLM_PROVIDER=gemini
# Optional. Leave unset to use the per-provider default:
#   gemini -> gemini-3.6-flash
#   claude -> claude-haiku-4-5
#   openai -> gpt-4.1-mini
# LLM_MODEL=

# Set the key for whichever provider(s) you plan to use.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Calendar ---
TIMEZONE=America/Sao_Paulo
CALENDAR_ID=primary
# Event length when the invite gives no end time.
DEFAULT_EVENT_HOURS=3
# JSON list of minutes-before-start for popup reminders. Default: 1 day + 2 hours.
REMINDER_MINUTES=[1440,120]

# --- Local files ---
DB_PATH=bot.db
CREDENTIALS_PATH=credentials.json
TOKEN_PATH=token.json
